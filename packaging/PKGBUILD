# Maintainer: fromaaage <fromaaage@pm.me>
pkgname=vardr
pkgver=1.0.0
pkgrel=1
pkgdesc="Update guardian for Arch-based systems: one-click updates, AUR, cache, mirrors, repositories, tray notifications"
arch=('any')
url="https://github.com/fromaaage/vardr"
license=('MIT')
depends=('python' 'pyside6' 'pacman-contrib' 'polkit')
optdepends=('paru: AUR updates'
            'yay: AUR updates'
            'rate-mirrors: rank mirrors'
            'garuda-update: default update command')
makedepends=('git')
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

package() {
    cd "$pkgname"
    install -d "$pkgdir/usr/share/$pkgname"
    cp -r app.py checker.py repos.py runner.py settings.py Main.qml qml icons "$pkgdir/usr/share/$pkgname/"
    python -m compileall -q -d "/usr/share/$pkgname" "$pkgdir/usr/share/$pkgname"
    install -Dm755 packaging/vardr.sh "$pkgdir/usr/bin/$pkgname"
    install -Dm644 packaging/vardr.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"
    install -Dm644 icons/vardr.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
    install -Dm755 packaging/polkit/vardr-root "$pkgdir/usr/lib/$pkgname/vardr-root"
    install -Dm755 packaging/polkit/vardr-sudo "$pkgdir/usr/lib/$pkgname/vardr-sudo"
    install -Dm644 packaging/polkit/org.vardr.policy "$pkgdir/usr/share/polkit-1/actions/org.vardr.policy"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
